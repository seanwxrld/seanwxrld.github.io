rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.token.admin == true; }
    match /products/{id} {
      allow read: if admin() || resource.data.status != 'hidden';
      allow write: if false; // Validated by admin-only callable.
    }
    match /shop_requests/{id} {
      allow read: if admin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /member_carts/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /newsletter_signups/{id} { allow read: if admin(); allow write: if false; }
    match /contact_messages/{id} { allow read: if admin(); allow write: if false; }
    match /campaigns/{id} { allow read: if admin(); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
