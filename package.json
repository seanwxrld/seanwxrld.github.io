{
  "name": "seanwxrld-site",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-sean-backstage 'node --test tests/rules.mjs'",
    "test:browser": "node tests/browser.mjs",
    "build:content": "node scripts/render-content.mjs",
    "test:content": "node --experimental-vm-modules --test tests/content-ui.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "12.12.1",
    "firebase-tools": "^15.0.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.8"
  }
}
